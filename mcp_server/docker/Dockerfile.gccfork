# syntax=docker/dockerfile:1
# Combined FalkorDB + Graphiti MCP Server Image — GCC fork build variant.
#
# Same as docker/Dockerfile except graphiti-core comes from the Growthcurve fork
# pinned by full commit SHA (pyproject.gccfork.toml), installed from a committed,
# fully-resolved lockfile (uv.lock.gccfork) so rebuilds are deterministic.
# To bump: edit the SHA in pyproject.gccfork.toml and GRAPHITI_CORE_REF below,
# regenerate the lock (see pyproject.gccfork.toml header), commit all three. The
# pinned commit must be pushed to GitHub before building: uv clones it.
#
# Build (from mcp_server/):
#   docker build -f docker/Dockerfile.gccfork -t graphiti-mcp:local .

# Pin the bundled FalkorDB: `latest` moved to 6.x. The GCC deployment runs FalkorDB
# in its own compose service (FALKORDB_URI=redis://falkordb:6379), so this copy is
# not the production engine; it is pinned to the same version (4.18.8) so the image
# behaves like production when run standalone. Upgrade the engine deliberately, in
# the compose service, with a backup of its data.
ARG FALKORDB_TAG=v4.18.8
FROM falkordb/falkordb:${FALKORDB_TAG} AS falkordb-base

# Install Python and system dependencies
# Note: Debian 13 "trixie" (FalkorDB base) ships with Python 3.13.
# procps is omitted: its postinst runs update-rc.d (a perl script), and the
# FalkorDB base image no longer ships perl (purged upstream for CVE reduction).
# git is required: uv clones the pinned graphiti-core commit.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-pip \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv for Python package management
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh

# Add uv to PATH
ENV PATH="/root/.local/bin:${PATH}"

# Configure uv for optimal Docker usage.
# SERVER__HOST: the MCP server binds 127.0.0.1 by default (upstream 417c3a1); in
# a container it must bind all interfaces to be reachable via the published port.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    SERVER__HOST="0.0.0.0" \
    PYTHONUNBUFFERED=1

# Set up MCP server directory
WORKDIR /app/mcp

# Informational only; the real pin lives in pyproject.gccfork.toml / uv.lock.gccfork.
ARG GRAPHITI_CORE_REF=Growthcurve/graphiti@5c27edfa8d3e0f49b2571bcebb4261bcc89ee037

COPY pyproject.gccfork.toml ./pyproject.toml
COPY uv.lock.gccfork ./uv.lock

# Install Python dependencies from the committed lock without re-resolving.
# --frozen: error rather than silently update uv.lock. Exclude dev group; include
# provider extras so the image matches the MCP server config/docs.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-group dev --extra providers --extra azure

# Store graphiti-core source ref
RUN echo "${GRAPHITI_CORE_REF}" > /app/mcp/.graphiti-core-version

# Copy MCP server application code
COPY main.py ./
COPY src/ ./src/
COPY config/ ./config/

# Copy FalkorDB combined config (uses localhost since both services in same container)
COPY config/config-docker-falkordb-combined.yaml /app/mcp/config/config.yaml

# Create log and data directories
RUN mkdir -p /var/log/graphiti /var/lib/falkordb/data

# Create startup script that runs both services
RUN cat > /start-services.sh <<'EOF'
#!/bin/bash
set -e

# Start FalkorDB in background using the correct module path
echo "Starting FalkorDB..."
redis-server \
  --loadmodule /var/lib/falkordb/bin/falkordb.so \
  --protected-mode no \
  --bind 0.0.0.0 \
  --port 6379 \
  --dir /var/lib/falkordb/data \
  --daemonize yes

# Wait for FalkorDB to be ready
echo "Waiting for FalkorDB to be ready..."
until redis-cli -h localhost -p 6379 ping > /dev/null 2>&1; do
  echo "FalkorDB not ready yet, waiting..."
  sleep 1
done
echo "FalkorDB is ready!"

# Start FalkorDB Browser if enabled (default: enabled)
if [ "${BROWSER:-1}" = "1" ]; then
  if [ -d "/var/lib/falkordb/browser" ] && [ -f "/var/lib/falkordb/browser/server.js" ]; then
    echo "Starting FalkorDB Browser on port 3000..."
    cd /var/lib/falkordb/browser
    HOSTNAME="0.0.0.0" node server.js > /var/log/graphiti/browser.log 2>&1 &
    echo "FalkorDB Browser started in background"
  else
    echo "Warning: FalkorDB Browser files not found, skipping browser startup"
  fi
else
  echo "FalkorDB Browser disabled (BROWSER=${BROWSER})"
fi

# Start MCP server in foreground
echo "Starting MCP server..."
cd /app/mcp
exec /root/.local/bin/uv run --no-sync main.py
EOF

RUN chmod +x /start-services.sh

# Add Docker labels with version information
ARG MCP_SERVER_VERSION=1.1.3
ARG BUILD_DATE
ARG VCS_REF
LABEL org.opencontainers.image.title="FalkorDB + Graphiti MCP Server" \
      org.opencontainers.image.description="Combined FalkorDB graph database with Graphiti MCP server" \
      org.opencontainers.image.version="${MCP_SERVER_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.vendor="Growthcurve" \
      org.opencontainers.image.source="https://github.com/Growthcurve/graphiti" \
      graphiti.core.version="${GRAPHITI_CORE_REF}"

# Expose ports
EXPOSE 6379 3000 8000

# Health check - verify FalkorDB is responding
# MCP server startup is logged and visible in container output
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD redis-cli -p 6379 ping > /dev/null || exit 1

# Override the FalkorDB entrypoint and use our startup script
ENTRYPOINT ["/start-services.sh"]
CMD []
